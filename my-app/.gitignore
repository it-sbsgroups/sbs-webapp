# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js build outputs (DO NOT COMMIT THESE)
/.next/
/out/

# production build (if you use /build for something else)
/build

# misc OS files
.DS_Store
*.pem

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# environment files (allow the example template)
.env*
!.env.example

# vercel deployment cache
.vercel

# typescript incremental builds
*.tsbuildinfo

# REMOVED: next-env.d.ts (commit this per Next.js docs)

# -------------------------------
# YOUR CUSTOM DOCUMENT RULES
# -------------------------------
# Ignore documents ONLY inside public, not the whole folder
public/**/*.pdf
public/**/*.docx
public/**/*.zip

# If you have documents elsewhere that you truly want to ignore globally:
# .pdf
# .docx
# .zip

# DO NOT ignore .txt globally (to keep robots.txt safe)