# DATABASE
DATABASE_URL="mysql://root:your_password@localhost:3306/sbs_web_db?allowPublicKeyRetrieval=true"

# CLOUDINARY
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
CLOUDINARY_API_ENVIRONMENT_VARIABLE="CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name"

# GEMINI
GEMINI_API_KEY="your_gemini_key"

# MAIL
SMTP_PASS="your_mail_app_password"
GMAIL_APP_NAME="SBS Groups Web"
SMTP_USER="your_mail@example.com"

# AUTH
JWT_SECRET="replace_with_long_random_secret"
DISABLE_AUTH="false"

# CORS
# comma-separated allowed browser origins in production
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://yourdomain.com"

# SERVER PORT
PORT=4000

# FRONTEND URL (used by the browser app when running locally)
NEXT_PUBLIC_API_URL="http://localhost:4000/api"